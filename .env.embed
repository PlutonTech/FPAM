# Used by `npm run build:embed` — the dashboard served at /app/ inside the public site.
# The public site's login page signs users in (same localStorage keys: as_token / as_user).
VITE_LOGIN_URL=/login.html
# The RMS prototype (localStorage-only demo) is included. Set VITE_RMS=off to leave it out.
VITE_RMS=on
# Hide the Revenue (demo) sidebar links on the site (pages still reachable by URL).
VITE_RMS_NAV=off
