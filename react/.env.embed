# Used by `npm run build:embed` — the dashboard served at /app/ inside the public site.
# The public site's login page signs users in (same localStorage keys: as_token / as_user).
VITE_LOGIN_URL=/login.html
# The RMS prototype (localStorage-only demo) is left out of the live site: its
# fake listings shouldn't appear under the government domain. Set VITE_RMS=on
# to include it again (pages at /app/revenue and /app/properties).
VITE_RMS=off
