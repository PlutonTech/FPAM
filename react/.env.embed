# Used by `npm run build:embed` — the dashboard served at /app/ inside the public site.
# The public site's login page signs users in (same localStorage keys: as_token / as_user).
VITE_LOGIN_URL=/login.html
# The RMS prototype (localStorage-only demo) is included, with its Revenue links in
# the sidebar (pages at /app/revenue and /app/properties). Set VITE_RMS=off to leave
# it out entirely, or VITE_RMS_NAV=off to keep the pages but hide the sidebar links.
VITE_RMS=on
